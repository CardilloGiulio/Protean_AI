# Optional deployment overrides. Local mode generates signing/encryption keys automatically.
DEBUG=false
SECURE_COOKIES=false
ACCESS_TOKEN_MINUTES=480
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000

# Production/managed deployments may inject these instead of generated instance files.
# JWT_SECRET_KEY=
# CREDENTIAL_ENCRYPTION_KEY=
